# JAM Sport en Apache (XAMPP)
DirectoryIndex index.html

# Archivos internos que no se publican: repositorio, scripts SQL, documentación y prototipos
RedirectMatch 404 "(?i)^.*/(\.git|\.vscode|API_JAM|docs|phpapi|myapi|temp|test|test3)(/.*)?$"
RedirectMatch 404 "(?i)^.*/(JAM|LICENSE|README\.md|\.gitignore)$"

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
