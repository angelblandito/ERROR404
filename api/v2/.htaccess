# API v2: todas las peticiones entran por index.php.
# Ningun otro archivo de esta carpeta se sirve directo (codigo, pruebas, build.php, .env, config).
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteCond %{REQUEST_URI} !/api/v2/index\.php$
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
