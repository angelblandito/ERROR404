# Copy this file to .env (same folder) and fill in the values for your machine.
# .env is in .gitignore, so it never reaches GitHub. Real environment variables override these values.
#
# The SQL Server and Azure SQL connection data go at the end of this file (JAM_LOCAL_*, JAM_CLOUD_*).

APP_TIMEZONE=America/Tijuana

# Key that signs the tokens (JWT HS256). Required: without it the API does not start.
# Generate one in PowerShell with:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
JWT_SECRET=
JWT_ALGORITHM=HS256
# 10080 minutes = 7 days
TOKEN_LIFETIME_MINUTES=10080
TOKEN_MIN_REMAINING_MINUTES=10

# Empty = same address only (the page and the API are served together by Apache).
# '*' allows any origin; or a list: https://a.com,https://b.com
CORS_ALLOW_ORIGIN=

# Address of the page. The links in the emails (password reset, orders) can only point here,
# to an origin of CORS_ALLOW_ORIGIN or to localhost
JAM_STORE_URL=http://localhost/ERROR404/

# Node used by the CRUD and the store
JAM_DEFAULT_NODE=central
# 1 = refuse plain http (virtual machine behind Caddy). Keep 0 on the local XAMPP
REQUIRE_HTTPS=0
# 1 behind Caddy (virtual machine): the client IP comes from X-Forwarded-For
TRUST_PROXY=0
# 0 turns off the request budget per IP (load tests only)
RATE_LIMIT=1

# Real email (optional). Without MAIL_HOST the emails are only saved in
# Administración > Correos. Gmail: turn on 2-Step Verification, create an app password
# at https://myaccount.google.com/apppasswords and paste it in MAIL_PASSWORD
# (16 letters, no spaces). Never the normal password.
MAIL_HOST=
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=JAM Sport

# Local SQL Server. Without user = Windows authentication (laptop).
# On the virtual machine: the jam_api user created by API_JAM/distribuida/06_pedidos_y_seguridad.sql
JAM_LOCAL_SERVER=localhost
JAM_LOCAL_USER=
JAM_LOCAL_PASSWORD=
# Empty = every node (central, tijuana, cdmx, online, cloud)
JAM_ENABLED_NODES=

# Azure SQL mirror (failover group). Without user and password the cloud node stays off.
JAM_CLOUD_SERVER=jam-fog.database.windows.net
JAM_CLOUD_MIRROR_SERVER=jam-fog.secondary.database.windows.net
JAM_CLOUD_DB=JAM_cloud
JAM_CLOUD_USER=
JAM_CLOUD_PASSWORD=
JAM_CLOUD_TIMEOUT=4
JAM_CLOUD_RETRY_AFTER=30
