# Copy this file to .env (same folder) and fill in the values for your machine.
# .env is in .gitignore, so it never reaches GitHub. Real environment variables override these values.
#
# The SQL Server passwords do NOT go here: the API reads them from the file the store already
# uses (api/v2/config/settings.php or api/v1/php/config/settings.php). Only write them here
# if API v3 must use different ones.

APP_HOST=localhost
APP_PORT=8000
APP_TIMEZONE=America/Tijuana

# Key that signs the tokens (JWT HS256). Required: without it the API does not start.
# Generate one in PowerShell with:
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
JWT_SECRET=
JWT_ALGORITHM=HS256
# 10080 minutes = 7 days, as long as the sessions of API v2 lasted
TOKEN_LIFETIME_MINUTES=10080
TOKEN_MIN_REMAINING_MINUTES=10

# Empty = same address only (the page and the API are served together by Apache).
# '*' allows any origin; or a list: https://a.com,https://b.com
CORS_ALLOW_ORIGIN=

# Address of the page. The links in the emails (password reset, orders) can only point here,
# to an origin of CORS_ALLOW_ORIGIN or to localhost
JAM_STORE_URL=http://localhost/ERROR404/

# Node used by the CRUD and the store
JAM_DEFAULT_NODE=central
# 1 = refuse plain http (virtual machine behind Caddy). Keep 0 on the local XAMPP
REQUIRE_HTTPS=0
# 1 behind Caddy (virtual machine): the client IP comes from X-Forwarded-For
TRUST_PROXY=0
# 0 turns off the request budget per IP (load tests only)
RATE_LIMIT=1
